# ─── Paths ────────────────────────────────────────────────────────────────────
# Absolute path to brain/content directory (default: ../../brain/content from backend/)
# VAULT_PATH=/absolute/path/to/brain/content

# Working directory opened in terminal when using the CLI button (default: repo root)
# WORK_DIR=/absolute/path/to/repo

# ─── Server ───────────────────────────────────────────────────────────────────
# PORT=3001

# ─── AI provider (choose one) ─────────────────────────────────────────────────

# Option A: Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Option B: Any OpenAI-compatible API (OpenRouter, OpenAI, local Ollama, etc.)
# AI_API_KEY=sk-...          # or OPENAI_API_KEY — both work
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# ─── CLI tool ─────────────────────────────────────────────────────────────────
# Command opened in Terminal when clicking the console button (default: claude)
# CLI_COMMAND=opencode

# ─── Google Calendar (optional) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/sync/oauth/callback
# GOOGLE_TIMEZONE=Europe/Moscow
